# Copy this file to backend/.env and fill in what you need. All settings are optional.

# Password for the first 'admin' account. Only used when the database is created.
ADMIN_PASSWORD=admin123

# ---------- SMS ----------
# Without any of these, SMS is "simulated": messages are only printed and logged.
#
# FREE: SMS Gateway for Android (https://sms-gate.app). Install the app on an Android phone
# with a SIM (an unlimited-text promo works well), switch on "Cloud server", and copy the
# username and password it shows.
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
#
# PAID: Semaphore (https://semaphore.co), a Philippine SMS gateway.
SEMAPHORE_API_KEY=
# Sender name approved on your Semaphore account (optional)
SEMAPHORE_SENDER_NAME=
#
# If both are set, this picks one: smsgate | semaphore | simulated
SMS_PROVIDER=

# Numbers that get an SMS when a scheduled pickup was not collected (comma-separated)
ADMIN_PHONES=

# The public website address. When set, reminders end with an opt-out link (<PUBLIC_URL>/stop).
PUBLIC_URL=

# ---------- Collection tracking ----------
# A pickup counts as collected when the area goes from full to clean between
# COLLECTION_BEFORE_MINUTES before and COLLECTION_AFTER_MINUTES after the scheduled time.
COLLECTION_BEFORE_MINUTES=120
COLLECTION_AFTER_MINUTES=240
# Collected this many minutes after the scheduled time or earlier counts as "on time"
COLLECTION_LATE_MINUTES=30

# ---------- Privacy (Data Privacy Act, RA 10173) ----------
# Shown on the public privacy notice (/privacy)
ORG_NAME=
PRIVACY_CONTACT=
# Camera photos are deleted automatically after this many days (0 = keep forever)
PHOTO_RETENTION_DAYS=30
# Manual recordings are deleted after this many days (0 = keep forever). Photos saved by hand follow PHOTO_RETENTION_DAYS.
RECORDING_RETENTION_DAYS=14

# ---------- Photos and videos in S3 (optional) ----------
# With S3_BUCKET set, photos, snapshots and recordings are uploaded to S3 and then deleted from this server.
# On EC2 use an instance role (no keys here). See deploy/README.md, section 5.
S3_BUCKET=
AWS_REGION=
S3_PREFIX=

# ---------- Manual recording ----------
# Longest recording, in seconds; how many may run at once; refuse to start with less free disk than this
RECORDING_MAX_SECONDS=600
RECORDING_MAX_CONCURRENT=2
RECORDING_MIN_FREE_MB=1024
# How often (seconds) the trash/clean verdict is noted while recording, shown on the video's timeline. 0 = off.
RECORDING_RESULT_SECONDS=5
# ffmpeg is found on PATH, else the copy that ships with the imageio-ffmpeg package. Set this to use another.
FFMPEG_BIN=

# ---------- Cameras ----------
# Network cameras (set an area's camera address on the Areas page). The server checks
# each one every CAMERA_CHECK_SECONDS by itself, even with no browser open. 0 = off.
CAMERA_CHECK_SECONDS=30
CAMERA_THRESHOLD=0.5
